# Use the key emitted for the agent you run locally.
DOME_TOKEN=

# Copy the gateway root emitted by `dome import outputs <job-id>`.
DOME_GATEWAY_URL=

# The demo-chess app uses these two distinct credentials in production.
DOME_CHESS_COACH_TOKEN=
DOME_OPPONENT_STOCKFISH_TOKEN=

# The public endpoint of the app's Stockfish MCP route; it is supplied to
# `dome import` as the stockfish_mcp_url variable.
STOCKFISH_MCP_URL=
